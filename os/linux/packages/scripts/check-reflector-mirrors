#!/bin/sh

set -eu

usage() {
  printf 'Usage: %s [--metadata-only | --pre-enable NOT_BEFORE_EPOCH]\n' "$0" >&2
  exit 2
}

mode=live
not_before_epoch=
case ${1:-} in
  '') ;;
  --metadata-only) mode=metadata; shift ;;
  --pre-enable)
    [ "$#" -eq 2 ] || usage
    mode=pre_enable
    not_before_epoch=$2
    shift 2
    case $not_before_epoch in
      ''|*[!0-9]*) usage ;;
    esac
    [ "$not_before_epoch" -gt 0 ] || usage
    ;;
  *) usage ;;
esac
[ "$#" -eq 0 ] || usage

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
packages_root=$(CDPATH='' cd -- "$script_dir/.." && pwd -P)
policy=$packages_root/reflector/reflector.conf
journal_filter=$packages_root/reflector/service-job-completions.jq
applicator=$script_dir/apply-reflector-mirrors
test_script=$script_dir/test-reflector-mirrors
config_target=/etc/xdg/reflector/reflector.conf
mirrorlist=/etc/pacman.d/mirrorlist
timer=reflector.timer
service=reflector.service
min_servers=5
max_servers=10
max_age_seconds=691200
checks=0

pass() {
  checks=$((checks + 1))
  printf 'PASS: %s\n' "$1"
}

fail() {
  printf 'FAIL: %s\n' "$1" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "missing command: $1"
}

[ -r "$policy" ] || fail "missing repository policy: $policy"
[ -r "$journal_filter" ] || fail "missing service journal filter: $journal_filter"
[ -x "$applicator" ] || fail "applicator is not executable: $applicator"
[ -x "$test_script" ] || fail "test is not executable: $test_script"
pass 'repository policy, journal filter, and commands exist with expected modes'

tmp_root=${TMPDIR:-/tmp}
actual_options=$(mktemp "$tmp_root/mydotfiles-reflector-options.XXXXXX")
expected_options=$(mktemp "$tmp_root/mydotfiles-reflector-expected.XXXXXX")
journal_output=
completion_output=
trap 'rm -f "$actual_options" "$expected_options" "${journal_output:-}" "${completion_output:-}"' EXIT HUP INT TERM

awk '
  /^[[:space:]]*($|#)/ { next }
  {
    sub(/^[[:space:]]*/, "")
    sub(/[[:space:]]*$/, "")
    print
  }
' "$policy" > "$actual_options"
cat > "$expected_options" <<'EOF'
--save /etc/pacman.d/mirrorlist
--protocol https
--completion-percent 100
--age 12
--latest 25
--sort rate
--number 10
--connection-timeout 5
--download-timeout 5
EOF
cmp -s "$actual_options" "$expected_options" ||
  fail 'repository policy options differ from the reviewed bounded policy'
if grep -Eq '(^|[[:space:]])(--country|-c)([[:space:]]|$)' "$actual_options"; then
  fail 'repository policy must not impose a country filter'
fi
pass 'policy is exact: recent HTTPS, 25 rated candidates, 10 outputs, no country lock'

reflector_count=$(
  find "$packages_root/lists" -type f -name '*.txt' -print |
    while IFS= read -r manifest; do
      awk '
        {
          sub(/[[:space:]]*#.*/, "")
          gsub(/^[[:space:]]+|[[:space:]]+$/, "")
          if ($0 == "reflector") print FILENAME
        }
      ' "$manifest"
    done |
    wc -l |
    tr -d '[:space:]'
)
[ "$reflector_count" -eq 1 ] ||
  fail "reflector must appear in exactly one official manifest (found $reflector_count)"
pass 'reflector is represented exactly once in the Linux package manifests'

if [ "$mode" = metadata ]; then
  printf 'REFLECTOR_MIRRORS_METADATA_OK (%s checks)\n' "$checks"
  exit 0
fi

[ "$(uname -s)" = Linux ] || fail 'live validation requires GNU/Linux'
for command_name in cmp date jq journalctl pacman sha256sum stat systemctl tail; do
  require_command "$command_name"
done
[ -r "$config_target" ] || fail "missing live Reflector config: $config_target"
[ -r "$mirrorlist" ] || fail "missing live mirrorlist: $mirrorlist"

expected_hash=$(sha256sum "$policy" | awk '{print $1}')
actual_hash=$(sha256sum "$config_target" | awk '{print $1}')
[ "$actual_hash" = "$expected_hash" ] || fail 'live Reflector config hash differs from repository policy'
cmp -s "$policy" "$config_target" || fail 'live Reflector config content differs from repository policy'
[ "$(stat -c '%U:%G:%a' "$config_target")" = root:root:644 ] ||
  fail 'live Reflector config must be root:root mode 0644'
pass "live Reflector config matches repository SHA-256 $expected_hash"

server_count=$(awk '/^[[:space:]]*Server[[:space:]]*=/{count++} END{print count+0}' "$mirrorlist")
[ "$server_count" -ge "$min_servers" ] ||
  fail "mirrorlist has only $server_count active Server entries (minimum $min_servers)"
[ "$server_count" -le "$max_servers" ] ||
  fail "mirrorlist has $server_count active Server entries (maximum $max_servers)"
if awk '
  /^[[:space:]]*Server[[:space:]]*=/ {
    line=$0
    sub(/^[[:space:]]*Server[[:space:]]*=[[:space:]]*/, "", line)
    if (line !~ /^https:\/\// || line !~ /\$repo\/os\/\$arch[[:space:]]*$/) exit 1
  }
' "$mirrorlist"; then
  :
else
  fail 'mirrorlist contains a non-HTTPS active Server entry'
fi
pass "mirrorlist has $server_count bounded HTTPS Server entries with pacman placeholders"

now_epoch=$(date +%s)
if [ -z "$not_before_epoch" ]; then
  not_before_epoch=$((now_epoch - max_age_seconds))
fi
[ "$not_before_epoch" -le "$now_epoch" ] || fail 'service validation lower bound is in the future'

service_type=$(systemctl show "$service" --property=Type --value)
remain_after_exit=$(systemctl show "$service" --property=RemainAfterExit --value)
collect_mode=$(systemctl show "$service" --property=CollectMode --value)
[ "$service_type" = oneshot ] || fail "$service is not Type=oneshot: ${service_type:-unset}"
[ "$remain_after_exit" = no ] || fail "$service unexpectedly remains active after exit"
[ "$collect_mode" = inactive ] || fail "$service has unexpected garbage collection: ${collect_mode:-unset}"
pass "$service has the reviewed oneshot lifecycle whose runtime timestamps are garbage-collected"

grep -F 'Arch Linux mirrorlist generated by Reflector' "$mirrorlist" >/dev/null ||
  fail 'mirrorlist lacks the Reflector generation header'
grep -E '^# With:[[:space:]]+reflector @/etc/xdg/reflector/reflector\.conf[[:space:]]*$' \
  "$mirrorlist" >/dev/null || fail 'mirrorlist was not generated with the packaged service config argument'
generated_when=$(awk '
  /^# When:[[:space:]]*/ {
    sub(/^# When:[[:space:]]*/, "")
    print
    exit
  }
' "$mirrorlist")
[ -n "$generated_when" ] || fail 'mirrorlist lacks a Reflector generation time'
generated_epoch=$(date -d "$generated_when" +%s) ||
  fail "cannot parse mirrorlist generation time: $generated_when"
mirrorlist_epoch=$(stat -c '%Y' "$mirrorlist")
[ "$generated_epoch" -ge "$not_before_epoch" ] ||
  fail 'mirrorlist header predates the required service execution window'
[ "$mirrorlist_epoch" -ge "$not_before_epoch" ] ||
  fail 'mirrorlist mtime predates the required service execution window'
[ "$generated_epoch" -le "$now_epoch" ] || fail 'mirrorlist generation time is in the future'
mtime_delta=$((mirrorlist_epoch - generated_epoch))
[ "$mtime_delta" -ge 0 ] && [ "$mtime_delta" -le 60 ] ||
  fail 'mirrorlist header and mtime do not describe the same generation'

journal_output=$(mktemp "$tmp_root/mydotfiles-reflector-journal.XXXXXX")
if ! journalctl --unit "$service" --since "@$not_before_epoch" --no-pager --output=json \
  > "$journal_output"; then
  fail "cannot read $service system journal"
fi
minimum_us=$((not_before_epoch * 1000000))
completion_output=$(mktemp "$tmp_root/mydotfiles-reflector-completions.XXXXXX")
if ! jq -c --arg unit "$service" --argjson minimum_us "$minimum_us" \
  -f "$journal_filter" "$journal_output" > "$completion_output"; then
  fail "$service journal contains invalid structured data"
fi
completion_record=$(tail -n 1 "$completion_output")
[ -n "$completion_record" ] || fail "$service has no start-job completion in the required window"
job_result=$(printf '%s\n' "$completion_record" | jq -r '.JOB_RESULT // ""')
message_id=$(printf '%s\n' "$completion_record" | jq -r '.MESSAGE_ID // ""')
completion_us=$(printf '%s\n' "$completion_record" | jq -r '.__REALTIME_TIMESTAMP // "0"')
[ "$job_result" = 'done' ] || fail "$service latest start job did not finish successfully: ${job_result:-unset}"
[ "$message_id" = 39f53479d3a045ac8e11786248231fbf ] ||
  fail "$service latest start completion lacks systemd's success message ID"
case $completion_us in
  ''|*[!0-9]*) fail "$service completion has an invalid realtime timestamp" ;;
esac
completion_epoch=$((completion_us / 1000000))
completion_delta=$((completion_epoch - generated_epoch))
[ "$completion_delta" -ge 0 ] && [ "$completion_delta" -le 60 ] ||
  fail 'latest successful service job and mirrorlist header are not the same refresh'
pass "$service latest start job succeeded and matches the generated mirrorlist in the required window"

if [ "$mode" != pre_enable ]; then
  systemctl is-enabled --quiet "$timer" || fail "$timer is not enabled"
  systemctl is-active --quiet "$timer" || fail "$timer is not active"
  pass "$timer is enabled and active"
fi

if [ "$mode" != pre_enable ]; then
  pacman -Si pacman >/dev/null 2>&1 || fail 'pacman cannot read refreshed repository metadata'
  [ -s /var/lib/pacman/sync/core.db ] || fail 'pacman core metadata is missing or empty'
  core_db_epoch=$(stat -c '%Y' /var/lib/pacman/sync/core.db)
  core_db_age=$((now_epoch - core_db_epoch))
  [ "$core_db_age" -ge 0 ] || fail 'pacman core metadata timestamp is in the future'
  [ "$core_db_age" -le "$max_age_seconds" ] || fail 'pacman core metadata is older than eight days'
  pass 'pacman repository metadata is readable, nonempty, and recent'
fi

if [ "$mode" = pre_enable ]; then
  printf 'REFLECTOR_MIRRORS_PRE_ENABLE_OK (%s checks)\n' "$checks"
else
  printf 'REFLECTOR_MIRRORS_LIVE_OK (%s checks)\n' "$checks"
fi
