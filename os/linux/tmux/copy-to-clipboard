#!/bin/sh

set -eu

# Never write a real clipboard when neither graphical session is available.
if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
  exec wl-copy
elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then
  exec xclip -selection clipboard
fi

printf 'No Linux clipboard backend available; selection remains in tmux.\n' >&2
cat > /dev/null
