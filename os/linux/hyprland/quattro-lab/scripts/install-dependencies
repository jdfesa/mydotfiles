#!/bin/sh

set -eu

usage() {
  cat <<'EOF'
Usage: os/linux/hyprland/quattro-lab/scripts/install-dependencies [--dry-run]

Install the desktop runtime dependencies for the pinned Quattro release.
Official Arch packages come from the host's configured repositories. The three
Omarchy-built packages are downloaded by exact filename and SHA-256; no Pacman
repository is added to /etc/pacman.conf.
EOF
}

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
lab_root=$(CDPATH='' cd -- "$script_dir/.." && pwd -P)
arch_packages=$lab_root/runtime/arch-packages.txt
special_packages=$lab_root/runtime/special-packages.lock
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}/mydotfiles/omarchy-quattro/packages
package_base_url=https://pkgs.omarchy.org/stable/x86_64
dry_run=0

if [ "${1:-}" = "--dry-run" ]; then
  dry_run=1
  shift
fi

if [ "$#" -ne 0 ]; then
  usage >&2
  exit 2
fi

if [ "$(uname -s)" != Linux ] || [ ! -r /etc/arch-release ]; then
  printf 'Quattro dependencies: Arch Linux is required\n' >&2
  exit 1
fi

if [ "$(uname -m)" != x86_64 ]; then
  printf 'Quattro dependencies: the pinned binary payloads require x86_64\n' >&2
  exit 1
fi

for command_name in curl pacman sha256sum sudo; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf 'Quattro dependencies: required command not found: %s\n' \
      "$command_name" >&2
    exit 127
  fi
done

set --
while IFS= read -r package_name || [ -n "$package_name" ]; do
  case $package_name in
    ''|'#'*) continue ;;
  esac
  set -- "$@" "$package_name"
done < "$arch_packages"

if [ "$dry_run" -eq 1 ]; then
  printf '[dry-run] sudo pacman -S --needed --'
  printf ' %s' "$@"
  printf '\n'
  while IFS=' ' read -r filename checksum || [ -n "$filename" ]; do
    case $filename in
      ''|'#'*) continue ;;
    esac
    printf '[dry-run] download %s/%s\n' "$package_base_url" "$filename"
    printf '[dry-run] verify SHA-256 %s\n' "$checksum"
    printf '[dry-run] sudo pacman -U --needed %s/%s\n' \
      "$cache_root" "$filename"
  done < "$special_packages"
  exit 0
fi

sudo -v
sudo pacman -S --needed -- "$@"

mkdir -p "$cache_root"
chmod 700 "$cache_root"
set --
while IFS=' ' read -r filename checksum || [ -n "$filename" ]; do
  case $filename in
    ''|'#'*) continue ;;
  esac
  package_path=$cache_root/$filename
  if [ ! -r "$package_path" ] || \
    ! printf '%s  %s\n' "$checksum" "$package_path" | sha256sum -c - >/dev/null 2>&1; then
    curl --fail --location --output "$package_path.part" \
      "$package_base_url/$filename"
    mv "$package_path.part" "$package_path"
  fi
  printf '%s  %s\n' "$checksum" "$package_path" | sha256sum -c -
  set -- "$@" "$package_path"
done < "$special_packages"

sudo pacman -U --needed -- "$@"

printf 'Quattro desktop dependencies installed.\n'
