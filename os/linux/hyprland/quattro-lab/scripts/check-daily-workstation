#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  printf 'Usage: %s [--metadata-only]\n' "$0" >&2
  exit 2
}

metadata_only=0
if [[ ${1-} == '--metadata-only' ]]; then
  metadata_only=1
  shift
fi
[[ $# -eq 0 ]] || usage

lab_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
repo_root=$(cd -- "$lab_root/../../../.." && pwd)
manifest=$repo_root/os/linux/packages/lists/40-quattro-daily-workstation.txt
installer=$repo_root/os/linux/packages/scripts/install-official-list
runtime=${OMARCHY_QUATTRO_RUNTIME:-${XDG_DATA_HOME:-$HOME/.local/share}/mydotfiles/omarchy-quattro/runtime}
expected_commit=f0020448ca87329199de7cb12f2015ebc4a3e5e7
checks=0

pass() {
  checks=$((checks + 1))
  printf 'PASS: %s\n' "$1"
}

fail() {
  printf 'FAIL: %s\n' "$1" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "missing command: $1"
}

require_package() {
  pacman -Q "$1" >/dev/null 2>&1 || fail "missing package: $1"
}

require_owned_command() {
  local command=$1 package=$2 path owner
  path=$(command -v "$command" 2>/dev/null) || fail "missing command: $command"
  owner=$(pacman -Qoq "$path" 2>/dev/null) || fail "unowned command: $path"
  [[ $owner == "$package" ]] || fail "$command is owned by $owner, expected $package"
}

require_owned_file() {
  local path=$1 package=$2 owner
  [[ -f $path ]] || fail "missing package file: $path"
  owner=$(pacman -Qoq "$path" 2>/dev/null) || fail "unowned package file: $path"
  [[ $owner == "$package" ]] || fail "$path is owned by $owner, expected $package"
}

require_exact_line() {
  local file=$1 line=$2 description=$3
  grep -Fx -- "$line" "$file" >/dev/null || fail "$description"
}

libreoffice_spanish_ui_selected() {
  python3 - "$HOME/.config/libreoffice" <<'PY'
import pathlib
import re
import sys

root = pathlib.Path(sys.argv[1])
pattern = re.compile(
    r'<prop\b[^>]*\b(?:oor:)?name=["\'](?:ooLocale|UILocale)["\'][^>]*>'
    r'.*?<value\b[^>]*>\s*es(?:[-_][A-Za-z]{2})?\s*</value>',
    re.IGNORECASE | re.DOTALL,
)
for path in root.rglob('*.xcu'):
    try:
        text = path.read_text(encoding='utf-8')
    except (OSError, UnicodeDecodeError):
        continue
    if pattern.search(text):
        raise SystemExit(0)
raise SystemExit(1)
PY
}

is_english_or_neutral_locale() {
  case $1 in
    C|C.*|POSIX|en|en_*) return 0 ;;
    *) return 1 ;;
  esac
}

"$installer" "$manifest" >/dev/null || fail 'official package manifest metadata'
pass 'all curated packages exist in enabled official repositories'

mapfile -t packages < <(
  sed -E -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$manifest"
)
for forbidden in 1password vial vial-git vial-appimage wf-recorder gpu-screen-recorder-ui libreoffice-fresh libreoffice-still-es; do
  if printf '%s\n' "${packages[@]}" | grep -Fx "$forbidden" >/dev/null; then
    fail "forbidden or intentionally deferred package in manifest: $forbidden"
  fi
done
pass 'manifest excludes deferred and redundant alternatives'

printf '%s\n' "${packages[@]}" | grep -Fx hunspell-es_any >/dev/null ||
  fail 'pure Spanish Hunspell dictionary missing from manifest'
if printf '%s\n' "${packages[@]}" | grep -E '^libreoffice-(still|fresh)-[^[:space:]]+$' >/dev/null; then
  fail 'LibreOffice UI language pack present in English baseline manifest'
fi
if printf '%s\n' "${packages[@]}" | grep -E '^hunspell-es_' | grep -Fvx hunspell-es_any >/dev/null; then
  fail 'unexpected additional Spanish dictionary in manifest'
fi
pass 'manifest allows only the reviewed pure Spanish spelling dictionary'

[[ -x $lab_root/config/compat-bin/omarchy-display-text-size ]] ||
  fail 'display text-size compatibility command'
[[ -x $lab_root/config/compat-bin/omarchy-font-set ]] ||
  fail 'font-set compatibility command'
[[ -x $lab_root/config/compat-bin/omarchy-screenshot-edit ]] ||
  fail 'screenshot editor compatibility command'
"$lab_root/scripts/test-kitty-compat" >/dev/null || fail 'Kitty compatibility test'
pass 'Kitty compatibility layer preserves managed symlinks'

bash -n "$lab_root/session/hyprland-quattro-lab" \
  "$lab_root/config/compat-bin/omarchy-kitty-safe" \
  "$lab_root/config/compat-bin/omarchy-screenshot-edit" ||
  fail 'Quattro daily shell syntax'
pass 'Quattro daily shell syntax'

if ! grep -F 'hl.unbind("SUPER + SHIFT + SLASH")' "$lab_root/config/hypr/bindings.lua" >/dev/null ||
  ! grep -F '"Bitwarden"' "$lab_root/config/hypr/bindings.lua" >/dev/null; then
  fail 'Bitwarden binding override'
fi
if ! grep -F '"install.service.1password"' "$lab_root/config/omarchy/extensions/omarchy-menu.jsonc" >/dev/null ||
  ! grep -F '"when": "omarchy-cmd-present bitwarden-desktop"' "$lab_root/config/omarchy/extensions/omarchy-menu.jsonc" >/dev/null ||
  ! grep -F '"action": "setsid uwsm-app -- bitwarden-desktop"' "$lab_root/config/omarchy/extensions/omarchy-menu.jsonc" >/dev/null; then
  fail 'Bitwarden menu override'
fi
if ! python3 - "$lab_root/config/omarchy/extensions/omarchy-menu.jsonc" <<'PY'
import json
import re
import sys

text = '\n'.join(
    line for line in open(sys.argv[1], encoding='utf-8')
    if not line.lstrip().startswith('//')
)
items = json.loads(re.sub(r',(?=\s*[}\]])', '', text))
item = items.get('install.service.1password', {})
assert item.get('label') == 'Bitwarden'
assert item.get('when') == 'omarchy-cmd-present bitwarden-desktop'
assert item.get('action') == 'setsid uwsm-app -- bitwarden-desktop'
PY
then
  fail 'Bitwarden JSONC menu override'
fi
pass 'Bitwarden binding and menu overrides are explicit'

[[ -d $runtime/.git ]] || fail "Quattro runtime checkout missing: $runtime"
[[ $(git -C "$runtime" rev-parse HEAD) == "$expected_commit" ]] ||
  fail 'Quattro runtime commit mismatch'
[[ -z $(git -C "$runtime" status --porcelain) ]] || fail 'Quattro runtime is dirty'
pass 'pinned Quattro runtime is exact and clean'

utilities=$runtime/default/hypr/bindings/utilities.lua
capture_menu=$runtime/default/omarchy/omarchy-menu.jsonc
capture_screenshot=$runtime/bin/omarchy-capture-screenshot

require_exact_line "$utilities" \
  'o.bind("SUPER + CTRL + C", "Capture menu", "omarchy-menu toggle capture")' \
  'upstream capture menu binding changed'
require_exact_line "$utilities" \
  'o.bind("PRINT", "Screenshot", "omarchy-capture-screenshot")' \
  'upstream Print screenshot binding changed'
require_exact_line "$utilities" \
  'o.bind("ALT + PRINT", "Screenrecording", "omarchy-capture-screenrecording --stop-recording || omarchy-menu toggle trigger.capture.screenrecord")' \
  'upstream Alt+Print screen-recording binding changed'
require_exact_line "$utilities" \
  'o.bind("SUPER + PRINT", "Color picker", "pkill hyprpicker || hyprpicker -a")' \
  'upstream Super+Print color-picker binding changed'
require_exact_line "$utilities" \
  'o.bind("SUPER + CTRL + PRINT", "Extract text (OCR) from screenshot", "omarchy-capture-text")' \
  'upstream Super+Ctrl+Print OCR binding changed'
require_exact_line "$utilities" \
  'o.bind("SUPER + ALT + comma", "Invoke last notification", "omarchy-shell notifications invokeLast")' \
  'upstream keyboard notification-action binding changed'

require_exact_line "$capture_menu" \
  '  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"omarchy-capture-screenshot"},' \
  'upstream screenshot menu action changed'
require_exact_line "$capture_menu" \
  '  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"omarchy-capture-text"},' \
  'upstream OCR menu action changed'
require_exact_line "$capture_menu" \
  '  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"omarchy-capture-qr"},' \
  'upstream QR menu action changed'
require_exact_line "$capture_menu" \
  '  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"omarchy-capture-screenrecording"},' \
  'upstream no-audio recording action changed'
require_exact_line "$capture_menu" \
  '  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"omarchy-capture-screenrecording --with-desktop-audio"},' \
  'upstream desktop-audio recording action changed'
require_exact_line "$capture_menu" \
  '  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"omarchy-capture-screenrecording --with-desktop-audio --with-microphone-audio"},' \
  'upstream microphone recording action changed'
require_exact_line "$capture_menu" \
  '  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"omarchy-hw-webcam","action":"omarchy-capture-screenrecording-with-webcam"},' \
  'upstream webcam recording action changed'
require_exact_line "$capture_screenshot" \
  "    omarchy-notification-send \"Screenshot saved to clipboard and file\" \"Edit with Super + Alt + , (or click this)\" \\" \
  'upstream keyboard annotation notification changed'
require_exact_line "$lab_root/session/hyprland-quattro-lab" \
  'export OMARCHY_SCREENSHOT_EDITOR=omarchy-screenshot-edit' \
  'Quattro screenshot editor selection changed'

if awk '!/^[[:space:]]*--/ && /PRINT|SUPER[[:space:]]*\+[[:space:]]*CTRL[[:space:]]*\+[[:space:]]*C|omarchy-capture-(screenshot|text|qr|screenrecording)/ { found=1 } END { exit !found }' \
  "$lab_root/config/hypr/bindings.lua"; then
  fail 'local capture binding overrides upstream Omarchy'
fi
pass 'capture bindings and commands match pinned Omarchy sources without local chords'

if ((metadata_only)); then
  printf 'QUATTRO_DAILY_METADATA_OK (%d checks)\n' "$checks"
  exit 0
fi

for package in "${packages[@]}"; do
  require_package "$package"
done
pass 'all curated packages are installed'

for variable in LANG LANGUAGE LC_ALL LC_CTYPE LC_NUMERIC LC_TIME LC_COLLATE \
  LC_MONETARY LC_MESSAGES LC_PAPER LC_NAME LC_ADDRESS LC_TELEPHONE \
  LC_MEASUREMENT LC_IDENTIFICATION; do
  value=${!variable-}
  [[ -z $value ]] || is_english_or_neutral_locale "$value" ||
    fail "$variable selects a non-English locale: $value"
done
grep -Fx 'LANG=en_US.UTF-8' /etc/locale.conf >/dev/null ||
  fail '/etc/locale.conf does not select en_US.UTF-8'
if awk '!/^[[:space:]]*(#|$)/ && $1 !~ /^en_US([.@]|$)/ { print; found=1 } END { exit !found }' /etc/locale.gen >/dev/null; then
  fail '/etc/locale.gen enables a non-English locale'
fi
locale -a | grep -Fxi en_US.utf8 >/dev/null || fail 'en_US.UTF-8 locale is not generated'
grep -Fx 'KEYMAP=us' /etc/vconsole.conf >/dev/null || fail 'virtual-console keymap is not US'
grep -Eq 'Option[[:space:]]+"XkbLayout"[[:space:]]+"us"' /etc/X11/xorg.conf.d/00-keyboard.conf ||
  fail 'declared XKB layout is not US'
if grep -Eq '^[[:space:]]*XKBVARIANT=.+|Option[[:space:]]+"XkbVariant"[[:space:]]+"[^[:space:]]+"' \
  /etc/vconsole.conf /etc/X11/xorg.conf.d/00-keyboard.conf; then
  fail 'an unreviewed keyboard variant is active'
fi
require_exact_line "$runtime/default/hypr/input.lua" \
  'local kb_layout = vconsole.XKBLAYOUT or "us"' \
  'upstream Quattro US keyboard fallback changed'
pass 'host and Quattro baseline select English locales and a US keyboard'

while read -r command package; do
  require_owned_command "$command" "$package"
done <<'EOF'
grim grim
slurp slurp
wl-copy wl-clipboard
satty satty
gpu-screen-recorder gpu-screen-recorder
mpv mpv
obs obs-studio
kdenlive kdenlive
obsidian obsidian
discord discord
Telegram telegram-desktop
kitty kitty
ghostty ghostty
bitwarden-desktop bitwarden
vlc vlc-cli
libreoffice libreoffice-still
tesseract tesseract
zbarimg zbar
EOF
pass 'expected commands are present and package-owned'

require_owned_file /usr/share/tessdata/eng.traineddata tesseract-data-eng
require_owned_file /usr/share/hunspell/es.aff hunspell-es_any
require_owned_file /usr/share/hunspell/es.dic hunspell-es_any
pass 'English OCR data and the allowed pure Spanish spelling data are package-owned'

for package in obs-studio kdenlive obsidian discord telegram-desktop kitty ghostty bitwarden vlc libreoffice-still; do
  pacman -Ql "$package" | grep -E '/usr/share/applications/[^/]+\.desktop$' >/dev/null ||
    fail "desktop entry missing from package: $package"
done
pass 'approved GUI packages provide desktop entries'

pacman -Q 1password >/dev/null 2>&1 && fail '1Password must remain absent'
pass '1Password is absent'

spanish_ui_packages=$(LC_ALL=C pacman -Qi | awk -F '[[:space:]]*:[[:space:]]*' '
  $1 == "Name" { name=$2 }
  $1 == "Description" {
    description=tolower($2)
    if (description ~ /spanish/ && description ~ /(language pack|locali[sz]ation|translation)/) print name
  }
')
[[ -z $spanish_ui_packages ]] ||
  fail "Spanish UI localization package installed: ${spanish_ui_packages//$'\n'/ }"
require_owned_file /usr/lib/libreoffice/help/en-US/contents.js libreoffice-still
require_owned_file /usr/lib/libreoffice/share/registry/res/fcfg_langpack_en-US.xcd libreoffice-still
[[ ! -e /usr/lib/libreoffice/program/resource/es ]] ||
  fail 'Spanish LibreOffice UI resources remain installed'
if [[ -d $HOME/.config/libreoffice ]] && libreoffice_spanish_ui_selected; then
  fail 'LibreOffice user configuration selects a Spanish UI locale'
fi
pass 'LibreOffice retains base English UI/help with no Spanish UI localization'

[[ -L $HOME/.config/xdg-terminals.list ]] || fail 'managed xdg-terminals.list symlink'
[[ $(readlink -f "$HOME/.config/xdg-terminals.list") == "$repo_root/os/linux/xdg/xdg-terminals.list" ]] ||
  fail 'xdg-terminals.list target'
[[ $(xdg-terminal-exec --print-id 2>/dev/null) == kitty.desktop ]] ||
  fail 'xdg-terminal-exec does not resolve Kitty'
pass 'Kitty is the managed default terminal'

[[ -L $HOME/.config/kitty/kitty.conf ]] || fail 'managed Kitty config symlink'
[[ $(readlink -f "$HOME/.config/kitty/kitty.conf") == "$repo_root/os/linux/kitty/kitty.conf" ]] ||
  fail 'Kitty config target'
cmp -s "$HOME/.config/kitty/kitty.conf" "$repo_root/os/linux/kitty/kitty.conf" ||
  fail 'Kitty config content mismatch'
grep -F "include \$HOME/mydotfiles/shared/kitty/common.conf" "$repo_root/os/linux/kitty/kitty.conf" >/dev/null ||
  fail 'Kitty Linux entrypoint does not include the shared base'
grep -F 'include ~/mydotfiles/shared/kitty/active-theme.conf' "$repo_root/shared/kitty/common.conf" >/dev/null ||
  fail 'Kitty shared base does not include the repository theme'
if grep -E 'omarchy|\.local/state' "$repo_root/os/linux/kitty/kitty.conf" \
  "$repo_root/shared/kitty/common.conf" >/dev/null; then
  fail 'Kitty config unexpectedly includes Quattro state'
fi
KITTY_CONFIG_FILE="$HOME/.config/kitty/kitty.conf" \
  kitty +runpy 'import os; from kitty.config import load_config; bad=[]; load_config(os.environ["KITTY_CONFIG_FILE"], accumulate_bad_lines=bad); raise SystemExit(bool(bad))' ||
  fail 'Kitty rejects the managed configuration'
pass 'Kitty entrypoint and theme source are repository-owned'

session_path="$HOME/.config/hypr-quattro/compat-bin:$runtime/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
[[ $(PATH=$session_path command -v omarchy-display-text-size) == "$HOME/.config/hypr-quattro/compat-bin/omarchy-display-text-size" ]] ||
  fail 'Quattro display text-size precedence'
[[ $(PATH=$session_path command -v omarchy-font-set) == "$HOME/.config/hypr-quattro/compat-bin/omarchy-font-set" ]] ||
  fail 'Quattro font-set precedence'
pass 'compatibility commands precede runtime only in Quattro PATH'

bash -n "$runtime/bin/omarchy-capture-screenshot" \
  "$runtime/bin/omarchy-capture-region" \
  "$runtime/bin/omarchy-capture-screenrecording" \
  "$runtime/bin/omarchy-capture-text" \
  "$runtime/bin/omarchy-capture-qr" ||
  fail 'pinned capture command syntax'
for command in grim slurp wl-copy satty gpu-screen-recorder obs ffmpeg mpv hyprctl jq tesseract zbarimg; do
  require_command "$command"
done
pass 'screenshot, annotation, OCR, QR, and recording commands resolve without capture'

printf 'QUATTRO_DAILY_WORKSTATION_OK (%d checks)\n' "$checks"
